# JARVIS Environment Variables Example

# Primary LLM Provider ("nvidia", "groq", "anthropic", "ollama")
JARVIS_LLM_PROVIDER=nvidia

# NVIDIA NIM API Settings
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here

# Groq API Settings (Optional)
GROQ_API_KEY=your_groq_key_here

# Anthropic API Settings (Optional)
ANTHROPIC_API_KEY=your_anthropic_key_here

# OpenWeatherMap API Settings (Optional)
OPENWEATHER_API_KEY=your_openweather_api_key_here

# Picovoice Porcupine Access Key (Optional for Wake Word)
PICOVOICE_ACCESS_KEY=your_picovoice_key_here

# User Addressing Preference
JARVIS_USER_TITLE=sir
